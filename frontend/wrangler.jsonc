// Cloudflare Worker for the Next.js frontend (OpenNext adapter, Prompt 55).
// Setup per https://opennext.js.org/cloudflare/get-started.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aafm-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aafm-dashboard"
    }
  ],
  // Routing (docs/deployment-plan.md): the Worker serves the app's hostname, and two routes
  // with NO Worker send /api/* and /socket.io* to the origin (EC2 behind Cloudflare), so pages,
  // API and WebSocket share one origin. The hostname's DNS record points at EC2 (proxied) and
  // this route runs the Worker on top; the two no-Worker routes
  // (aafm-dashboard.kelados.in/api/* and /socket.io*) are set in the dashboard (Workers Routes,
  // Worker: None). A Custom Domain would not work here: it makes the Worker the origin for
  // every path (docs/deployment-plan.md section 8).
  "routes": [
    { "pattern": "aafm-dashboard.kelados.in/*", "zone_name": "kelados.in" }
  ],
  // One public origin only: a workers.dev copy could never sign in (no /api behind it).
  "workers_dev": false,
  "observability": { "enabled": true }
}
