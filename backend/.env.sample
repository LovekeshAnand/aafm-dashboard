NODE_ENV=development
PORT=8000

# Request connections use the restricted role aafm_app, which is bound by RLS.
# `npm run migrate` creates or updates it with APP_DB_PASSWORD.
DATABASE_URL=postgres://aafm_app:change-me@localhost:5432/aafm_dashboard
APP_DB_PASSWORD=change-me
DB_POOL_MAX=10

# Owner/superuser connection, used only by migrations, seed and tests.
MIGRATION_DATABASE_URL=postgres://postgres:your-postgres-password@localhost:5432/aafm_dashboard

# Frontend origin(s) allowed to send credentialed requests (comma-separated). Unset = no CORS.
CORS_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (1 behind Nginx). 0 locally.
TRUST_PROXY=0
# Sign-up/login attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=10

# Optional: password for all seed users (default Password@123).
SEED_PASSWORD=

# Live metrics (Tier 2 B): seconds between simulated ticks; 0 disables the simulator.
SIMULATOR_INTERVAL_SECONDS=5
