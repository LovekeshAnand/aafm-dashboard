NODE_ENV=development
PORT=8000

# Request connections use the restricted role aafm_app, which is bound by RLS.
# `npm run migrate` creates or updates it with APP_DB_PASSWORD.
DATABASE_URL=postgres://aafm_app:change-me@localhost:5432/aafm_dashboard
APP_DB_PASSWORD=change-me
DB_POOL_MAX=10

# Owner/superuser connection, used only by migrations, seed and tests.
MIGRATION_DATABASE_URL=postgres://postgres:your-postgres-password@localhost:5432/aafm_dashboard

# Frontend origin(s) allowed to send credentialed requests (comma-separated). Unset = no CORS.
CORS_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (1 behind Nginx). 0 locally.
TRUST_PROXY=0
# Sign-up/login attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=10

# Optional: password for all seed users (default Password@123).
SEED_PASSWORD=

# Live metrics (Tier 2 B): seconds between simulated ticks; 0 disables the simulator.
SIMULATOR_INTERVAL_SECONDS=5

# Tier 3 C: webhook delivery worker. Poll interval in seconds (0 disables the worker).
WEBHOOK_POLL_SECONDS=2
# Development and tests only: allow webhooks to private/loopback addresses (a local receiver).
# Never set this in production; it switches off the SSRF address check.
WEBHOOK_ALLOW_PRIVATE=1
# Tier 3 C (Prompt 50): AES-256-GCM keyring for webhook signing secrets. Kept outside the
# database and the repo (backend/secrets/ is git-ignored); create it with `npm run keyring -- init`.
# Production: mount it from a secret store (e.g. a Docker secret at /run/secrets/...).
WEBHOOK_KEYRING_FILE=./secrets/webhook-keyring.json

# Production hardening (docs/edge-case-audit.md). All optional; these are the defaults.
# API_RATE_LIMIT=600          # requests per minute per session (E1)
# API_WRITE_RATE_LIMIT=120    # writes per minute per session (E1)
# DB_CONNECT_TIMEOUT_MS=5000  # wait for a free DB connection before answering 503 (E8)
#   Note: the Socket.IO Postgres adapter holds one pool connection for LISTEN permanently,
#   so the pool available to requests is DB_POOL_MAX - 1.
# WEBHOOK_TIMEOUT_MS=10000    # deadline per webhook attempt (E15)
# HOUSEKEEPING_MINUTES=5      # cleanup and audit compaction interval; 0 disables (E14, E19)
# AUDIT_HOT_DAYS=7            # audit entries newer than this stay as rows; older are archived (E19)
# RUN_WORKERS=true          # false when the jobs run in their own process: `npm run worker` (#39)
