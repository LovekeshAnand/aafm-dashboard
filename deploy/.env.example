# deploy/.env on the EC2 instance (copy this file, fill it in, chmod 600). Never commit it.
# Generate each password with:  openssl rand -hex 32   (hex: safe inside connection URLs)

# Postgres superuser (migrations, the cross-tenant jobs) and the restricted app role (RLS).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# 8 GB disk (Prompt 60): a tick every 15 s keeps 30 days of live metrics around 1 GB.
SIMULATOR_INTERVAL_SECONDS=15

# The site the browser uses (pages and API share it), e.g. https://app.example.com
CORS_ORIGIN=

# Optional tuning; these are the defaults (see backend/.env.sample).
# AUTH_RATE_LIMIT=10
# API_RATE_LIMIT=600
# API_WRITE_RATE_LIMIT=120
# AUDIT_HOT_DAYS=7

# Never in production: WEBHOOK_ALLOW_PRIVATE (it switches off the SSRF address check).
